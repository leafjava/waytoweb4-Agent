# Offline defaults: no external calls and no public-chain transactions.
KILN_MODE=offline
PASSPORT_BACKEND=mock

# Live Kiln (Challenge A requires the exact gpt-oss-120b model).
KILN_API_BASE=
KILN_API_KEY=
KILN_MODEL=gpt-oss-120b

# Public-testnet passport transport. Set PASSPORT_BACKEND=testnet only for
# an authorized field rehearsal with a dedicated funded test wallet.
RPC_URL=
PRIVATE_KEY=
CHAIN_ID=11155111
PASSPORT_ADDRESS=
TX_TIMEOUT_MS=60000
CHAIN_JOURNAL_DIR=chain/var/live-journal
